# ============================================================
# Aura AI Backend – Environment Variables Template
# Copy this to .env and fill in your actual values
# ============================================================

# --- Database (PostgreSQL) ---
DATABASE_URL="postgresql://user:password@localhost:5432/aura_db?schema=public"

# --- Redis (for BullMQ background worker) ---
# Use a Redis connection string. Upstash TLS example:
REDIS_URL="rediss://default:<password>@<host>:6379"

# --- Clerk Authentication ---
CLERK_SECRET_KEY="sk_test_..."
CLERK_PUBLISHABLE_KEY="pk_test_..."
# For production webhook verification (from Clerk dashboard):
CLERK_WEBHOOK_SECRET="whsec_..."

# --- LLM Providers (at least one required) ---
GEMINI_API_KEY="AIzaSy..."          # Google Gemini – free tier available
GROQ_API_KEY="gsk_..."             # Groq – free tier available
OPENROUTER_API_KEY="sk-or-v1-..."  # OpenRouter – pay-as-you-go

# --- Internet Search (internet_search tool) ---
# Free tier: 1,000 requests/month, no credit card required
# Get your key at: https://app.tavily.com
TAVILY_API_KEY="tvly-..."

# --- Vector Database (Pinecone) – for document RAG ---
PINECONE_API_KEY="pcsk_..."
PINECONE_INDEX="aura-index"        # Must be 3072-dim (gemini-embedding-001)

# --- Optional ---
# URL of your deployed frontend (for CORS in production)
FRONTEND_URL="https://your-frontend.vercel.app"

# Server port (default: 8000)
PORT=8000

# RAG relevance score threshold (0.0 – 1.0, default: 0.5)
# Lower this (e.g. 0.3) if document searches return "low relevance" for short documents
RAG_SCORE_THRESHOLD=0.5
